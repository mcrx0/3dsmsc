# Build output. The project is always built out of source (cmake -B build), so these
# directories hold every object file, library, ELF, and the generated icon sheet.
build/
build-*/
cmake-build-*/

# The finished .3dsx copied here by the 3DS build, ready to test on a console.
dist/

# Binaries are never committed, wherever they end up.
*.3dsx
*.smdh

# Python bytecode from importing the scripts in scripts/.
__pycache__/

# clangd: its index, and the compile database often symlinked into the repository root.
.cache/
compile_commands.json

# Local tooling and editors.
.codegraph/
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
